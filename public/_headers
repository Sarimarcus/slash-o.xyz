# Cloudflare Pages reads this file and applies these headers to the response.
# The site is fully static, sets no cookies and loads no third-party script, so
# the policy can be genuinely strict rather than nominally so.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # 'unsafe-inline' on style-src is required by astro.config's
  # build.inlineStylesheets: 'always', which inlines the stylesheet into the
  # document. On script-src it covers the one inline head script (the
  # live-field class) and Astro's inlined module scripts.
  #
  # This is a real weakening, and it is acceptable only while the site stays as
  # it is: no form, no user input, no third-party script, no server — nothing
  # for injected script to be injected through. Adding a form or any
  # user-generated content means moving to a nonce or hash policy first.
  #
  # frame-src is 'none' because nothing is embedded yet. An embedded player or
  # map needs its origin added here explicitly.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'; object-src 'none'

# Astro fingerprints everything under /_astro, so it can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are versioned by filename (subset + axis range in the name); change the
# name when the file changes.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The static plot changes whenever the shader constants do; a day is enough.
/field-rest.svg
  Cache-Control: public, max-age=86400
