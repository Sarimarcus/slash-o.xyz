---
import Base from '@/layouts/Base.astro';
import PlateHead from '@/components/PlateHead.astro';
---

<Base title="Not found" description="This page does not exist." indexable={false}>
  <PlateHead hide={['readings']} />
  <main>
    <section class="band" aria-labelledby="nf-title">
      <div class="margin">
        <h1 id="nf-title" class="band-title">Nothing measured here</h1>
      </div>
      <div class="content">
        <p class="intro">There is no page at this address.</p>
        <p><a href="/">Back to the plate</a></p>
      </div>
    </section>
  </main>
</Base>
