---
/**
 * The document shell every page renders into.
 *
 * It owns the things that must be identical and correct on every URL — the
 * canonical link, the social card tags, the stylesheet, the font preload — so a
 * page component only has to supply its own title, description and body.
 */
import { SITE, SITE_URL } from '@/data/site';
import '@/styles/global.css';

interface Props {
  /** Page title. Suffixed with the site name unless it already is the site name. */
  title: string;
  /** Falls back to the site-wide description. */
  description?: string;
  /** False on pages that must stay out of search results, e.g. 404. */
  indexable?: boolean;
}

const { title, description = SITE.description, indexable = true } = Astro.props;

const pageTitle = title === SITE.name ? `${SITE.name}: ${SITE.tagline}` : `${title}: ${SITE.name}`;

// Two corrections, both load-bearing:
//
// 1. Astro.url carries the dev server's origin, so rebuild against the
//    canonical one — otherwise previews advertise localhost as canonical.
// 2. build.format: 'file' makes the pathname '/index.html' and '/404.html' at
//    build time, while @astrojs/sitemap emits '/' and the served URL is '/404'.
//    Left alone, canonical and sitemap would disagree about the same page.
const canonicalPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(canonicalPath, SITE_URL).href;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#e4dfd1" />

    {/* Visitors who will get the live canvas never fetch the static plot. Runs
        before first paint; reduced motion and no-JS keep the plot. If the hero
        module has not gone live within a few seconds (blocked script, no
        WebGL2, slow network), the plot comes back rather than blank linen.
        A visit that starts at the top also holds back the mark's slash, which
        is cut once the last contour lands; one that starts at an anchor, and
        any visit whose field never goes live, sees it at once. */}
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var root = document.documentElement;
        root.classList.add('live-field');
        if (!location.hash) root.classList.add('mark-pending');
        setTimeout(function () {
          if (!document.querySelector('.is-live')) root.classList.remove('live-field', 'mark-pending');
        }, 4000);
      }
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* The roman sets the hero text, the LCP element; preload only that one. */}
    <link
      rel="preload"
      href="/fonts/source-serif-4-opsz-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', SITE_URL).href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />

    {/* summary_large_image, not summary: the card is a plate, and a 1200x630
        plate cropped to a 120px square thumbnail is a grey smudge. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.png', SITE_URL).href} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>
