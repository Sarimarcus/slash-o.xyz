---
/**
 * The hero band: the live field, the readouts in the margin, the headline and
 * the two actions. The h1 is the page's LCP element: it is plain HTML painted
 * before any script is requested. The field's script loads after idle time and
 * intersection, and never under prefers-reduced-motion.
 */
import { HERO } from '@/data/copy';
import { PERSON, isPlaceholder } from '@/data/site';
import { sampleField, contourIndex, isotherm, LEVELS } from '@/hero/noise.js';

// Static readout values for no-JS and reduced-motion: the field at rest, at
// the plate centre, with seed 0 and a 16:9 plate, recorded at build.
const rest = sampleField({ u: 0.5, v: 0.5, aspect: 16 / 9, time: 0, zone: 0, seed: 0, pointer: [0.5, 0.5], probe: 0 });
const restT = isotherm(rest, 0).toFixed(1);
const restN = contourIndex(rest);

const bookHref = isPlaceholder(PERSON.calendar)
  ? isPlaceholder(PERSON.email)
    ? '#contact'
    : `mailto:${PERSON.email}?subject=A%20conversation`
  : PERSON.calendar;
---

<section id="top" class="band band--hero" aria-labelledby="hero-title" data-hero>
  <div class="field" data-field aria-hidden="true"></div>

  <div class="margin">
    <dl class="meta readout" data-readout>
      <div>
        <dt>Isotherm</dt>
        <dd><span data-r="t">{restT}</span> <span class="unit">°</span></dd>
      </div>
      <div>
        <dt>Contour</dt>
        <dd><span data-r="n">{restN}</span> / {LEVELS}</dd>
      </div>
      <div>
        <dt>Zone</dt>
        <dd><span data-r="z">0.00</span></dd>
      </div>
      <div>
        <dt>Probe</dt>
        <dd>x <span data-r="x">.500</span> &nbsp;y <span data-r="y">.500</span></dd>
      </div>
    </dl>
    <p class="readout-note" data-note-live hidden>{HERO.readoutNote}</p>
    <p class="readout-note" data-note-static>{HERO.readoutStaticNote}</p>
  </div>

  <div class="content">
    <div class="hero-copy" data-copy>
      <h1 id="hero-title">{HERO.h1}</h1>
      <p class="lede">{HERO.lede}</p>
      <p class="actions">
        <a class="button" href={bookHref}>{HERO.primary}</a>
        <a class="text-link" href="#how">{HERO.secondary}</a>
      </p>
    </div>
  </div>
</section>

<script>
  // Gate: reduced motion never initialises the canvas; otherwise wait for idle
  // time AND for the hero to be in view before fetching the chunk.
  const host = document.querySelector<HTMLElement>('[data-hero]');
  const field = host?.querySelector<HTMLElement>('[data-field]');
  const copy = host?.querySelector<HTMLElement>('[data-copy]');
  const readout = host?.querySelector<HTMLElement>('[data-readout]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (host && field && copy && readout && !reduced) {
    const idle = new Promise<void>((resolve) => {
      if ('requestIdleCallback' in window) (window as Window).requestIdleCallback(() => resolve(), { timeout: 2000 });
      else setTimeout(resolve, 200);
    });
    const seen = new Promise<void>((resolve) => {
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) {
          io.disconnect();
          resolve();
        }
      });
      io.observe(host);
    });
    Promise.all([idle, seen])
      .then(() => import('@/hero/hero.js'))
      .then(({ initHero }) => {
        const live = initHero({ host, field, copy, readout });
        if (live) {
          host.querySelector('[data-note-live]')?.removeAttribute('hidden');
          host.querySelector('[data-note-static]')?.setAttribute('hidden', '');
        } else {
          document.documentElement.classList.remove('live-field');
        }
      })
      .catch(() => document.documentElement.classList.remove('live-field'));
  }
</script>
