---
/**
 * Rows set side by side, one on show at a time: a horizontal track that snaps
 * to each row, with a ruled row of controls beneath it. The script builds the
 * track; without JavaScript the rows stack like any band's and the controls
 * stay hidden. Every row stays in the document, so reading in order and
 * find-in-page still reach the ones off screen.
 *
 * With one row there is nothing to turn: it renders as a plain row, no track.
 */
interface Props {
  /** What the rows are, for the region's name and the counter. */
  label: string;
  /** How many rows the slot holds. */
  count: number;
}
const { label, count } = Astro.props;
const turns = count > 1;
---

{turns ? (
  <div class="slides" data-slides>
    <div class="slides-track" data-label={label}>
      <slot />
    </div>
    <div class="row slides-controls" hidden>
      <div class="row-margin">
        <p class="slides-count" aria-live="polite"><span data-slides-at>1</span> of {count}</p>
      </div>
      <div class="row-content">
        <p class="slides-turn">
          <button type="button" class="slides-button" data-slides-step="-1">Previous</button>
          <button type="button" class="slides-button" data-slides-step="1">Next</button>
        </p>
      </div>
    </div>
  </div>
) : (
  <slot />
)}

<script>
  // Turns the track a row at a time and keeps the counter on the row in view.
  // The counter is written when a scroll settles, so a swipe across several
  // rows announces where it stopped rather than every row it passed.
  const smooth = matchMedia('(prefers-reduced-motion: no-preference)');
  for (const root of document.querySelectorAll<HTMLElement>('[data-slides]')) {
    const track = root.querySelector<HTMLElement>('.slides-track')!;
    const controls = root.querySelector<HTMLElement>('.slides-controls')!;
    const at = root.querySelector<HTMLElement>('[data-slides-at]')!;
    const [prev, next] = root.querySelectorAll<HTMLButtonElement>('[data-slides-step]');
    const count = track.children.length;
    const clamp = (i: number) => Math.min(count - 1, Math.max(0, i));
    const index = () => clamp(Math.round(track.scrollLeft / track.clientWidth));
    // The row a turn is heading for, so a second click during a turn counts
    // from where the first one is going rather than from where the track is.
    let target = index();

    const settle = () => {
      const i = (target = index());
      at.textContent = String(i + 1);
      // A button that is disabled while focused drops focus to the page, so
      // hand it to the other button first.
      const [atStart, atEnd] = [i === 0, i === count - 1];
      if (atStart && document.activeElement === prev) next.focus();
      if (atEnd && document.activeElement === next) prev.focus();
      prev.disabled = atStart;
      next.disabled = atEnd;
    };

    for (const button of [prev, next]) {
      button.addEventListener('click', () => {
        target = clamp(target + Number(button.dataset.slidesStep));
        track.scrollTo({ left: target * track.clientWidth, behavior: smooth.matches ? 'smooth' : 'auto' });
      });
    }

    let timer = 0;
    if ('onscrollend' in window) track.addEventListener('scrollend', settle);
    else
      track.addEventListener('scroll', () => {
        clearTimeout(timer);
        timer = window.setTimeout(settle, 120);
      });

    // Built only here, so without JavaScript the rows stack and nothing
    // claims to be a carousel.
    track.tabIndex = 0;
    track.setAttribute('role', 'region');
    track.setAttribute('aria-roledescription', 'carousel');
    track.setAttribute('aria-label', track.dataset.label ?? '');
    root.classList.add('slides--turning');
    controls.hidden = false;
    settle();
  }
</script>
