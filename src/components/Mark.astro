---
/**
 * The /O mark: Source Serif 4's O and a slash redrawn at 70deg, the one angle
 * every hatch and tick on the page shares. The slash is oxide, the O ink (or the surrounding text colour inline). Both
 * are outlines from src/data/mark.ts, so the mark does not wait for the web font.
 * It is used twice, in the plate head and inline in the refusal, so it carries
 * no id.
 */
import { MARK_BOX, MARK_SLASH, MARK_O } from '@/data/mark';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox={`0 0 ${MARK_BOX.w} ${MARK_BOX.h}`}
  role="img"
  aria-label="Slash O"
  xmlns="http://www.w3.org/2000/svg"
>
  <title>Slash O</title>
  <path class="mark-slash" d={MARK_SLASH} />
  <path class="mark-o" d={MARK_O} />
</svg>
