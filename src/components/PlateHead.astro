---
/**
 * The plate's header row: the mark in the margin column, the anchor nav across
 * the content column. Nav labels are the fragment paths themselves, so the
 * slash does typographic and navigational work at once.
 */
import Mark from './Mark.astro';
import { NAV } from '@/data/copy';

interface Props {
  /** Fragment ids to leave out (a band hidden in production). */
  hide?: string[];
}
const { hide = [] } = Astro.props;
const items = NAV.filter((n) => !hide.includes(n.href.replace(/^\/?#/, '')));
---

<header class="plate-head">
  <a class="mark" href="/" aria-label="Slash O, home"><Mark /></a>
  <nav class="path-nav" aria-label="Sections">
    <ul>
      {items.map((n) => (
        <li><a href={n.href} data-nav>{n.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // Marks the band currently in view. Progressive: without it the nav is a
  // plain list of anchors.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav]'));
  const sections = links
    .map((a) => document.getElementById(a.hash.slice(1)))
    .filter((s): s is HTMLElement => s !== null);
  if (sections.length && 'IntersectionObserver' in window) {
    const visible = new Map<Element, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) visible.set(e.target, e.isIntersecting ? e.intersectionRatio : 0);
        let best: Element | null = null;
        let bestRatio = 0;
        for (const [el, ratio] of visible) {
          if (ratio > bestRatio) {
            best = el;
            bestRatio = ratio;
          }
        }
        for (const a of links) {
          const on = best !== null && a.hash === `#${best.id}`;
          if (on) a.setAttribute('aria-current', 'true');
          else a.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-25% 0px -55% 0px', threshold: [0, 0.1, 0.25, 0.5, 0.75, 1] },
    );
    sections.forEach((s) => io.observe(s));
  }

  // Arrival. Following an in-page link rules off the band it lands on (the
  // .arrived rule in global.css) once the scroll has settled, so the mark is
  // drawn where the reader is looking, not halfway down a smooth scroll.
  // Landing on the refusal also redraws its hatch behind a 70deg edge.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const TAN_SLASH = Math.tan((70 * Math.PI) / 180);
  let pending = 0;

  function settled(): Promise<void> {
    return new Promise((resolve) => {
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        window.removeEventListener('scrollend', finish);
        resolve();
      };
      if ('onscrollend' in window) {
        window.addEventListener('scrollend', finish, { once: true });
        // No scroll happens when the target is already in place.
        setTimeout(finish, 1200);
      } else {
        setTimeout(finish, 700);
      }
    });
  }

  function sweepHatch(row: HTMLElement) {
    if (reduced.matches || !row.animate) return;
    const { width, height } = row.getBoundingClientRect();
    const run = height / TAN_SLASH;
    const edge = (x: number) => `polygon(0 0, ${x}px 0, ${x - run}px 100%, 0 100%)`;
    row.animate([{ clipPath: edge(0) }, { clipPath: edge(width + run) }], {
      duration: 700,
      easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
      pseudoElement: '::before',
    });
  }

  async function arrive(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    const ticket = ++pending;
    await settled();
    if (ticket !== pending) return;
    const band = el.closest<HTMLElement>('.band:not(.band--hero)');
    document.querySelectorAll('.band.arrived').forEach((b) => b.classList.remove('arrived'));
    if (band) {
      void band.offsetWidth; // restart the draw on a repeat visit
      band.classList.add('arrived');
    }
    const refusal = el.closest<HTMLElement>('.row--refusal');
    if (refusal) sweepHatch(refusal);
  }

  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest?.<HTMLAnchorElement>('a[href*="#"]');
    if (!a || a.pathname !== location.pathname || !a.hash) return;
    arrive(decodeURIComponent(a.hash.slice(1)));
  });
</script>
