---
/**
 * One band of the plate. The first row opens the band: its title at display
 * size in the content column, with the intro beneath it, and the margin column
 * beside it left to whatever the band annotates. Further rows (Row.astro)
 * carry a passage each, with its note in the margin beside it. Below 48rem the
 * margin's note follows the band's opening as a footnote, and an empty margin
 * is not shown.
 */
interface Props {
  id: string;
  title: string;
  class?: string;
}
const { id, title, class: className } = Astro.props;
const titleId = `${id}-title`;
const hasMargin = Astro.slots.has('margin');
---

<section id={id} class:list={['band', className]} aria-labelledby={titleId}>
  <div class:list={['margin', { 'margin--empty': !hasMargin }]}>
    <slot name="margin" />
  </div>
  <div class="content">
    <h2 id={titleId} class="band-title">{title}</h2>
    <slot />
  </div>
  <slot name="rows" />
</section>
